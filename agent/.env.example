# Copy missing settings into the repo-root .env — do not overwrite existing keys there.
# Never commit real credentials (the repo-root .env is gitignored; this file is not).

# OpenRouter is the default model provider (LLM_MODEL below). Anthropic/OpenAI remain
# supported directly if you prefer: LLM_MODEL=anthropic/... or openai/..., with the
# matching key below instead of OPENROUTER_API_KEY.
LLM_MODEL=openrouter/anthropic/claude-sonnet-4.6
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=1200

EXA_API_KEY=
EXA_TIMEOUT_SECONDS=15

AMBIGUOUS_API_KEY=
AMBIGUOUS_TIMEOUT_SECONDS=15

# Required for `python -m agent serve` unless --local-no-auth (loopback dev only).
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

AGENT_PORT=8000
APPROVAL_SERVER_PORT=5050
APPROVAL_TIMEOUT_SECONDS=120
