# Copy desired settings into agent/.env. Never commit real credentials.
LLM_MODEL=openrouter/anthropic/claude-sonnet-4.6
OPENROUTER_API_KEY=
# Optional direct providers, selected with anthropic/... or openai/...:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=1200
EXA_API_KEY=
EXA_TIMEOUT_SECONDS=15
AMBIGUOUS_API_KEY=
AMBIGUOUS_TIMEOUT_SECONDS=15
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AGENT_PORT=8000
APPROVAL_SERVER_PORT=5050
APPROVAL_TIMEOUT_SECONDS=120
