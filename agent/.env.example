# Copy missing settings into the repo-root .env — do not overwrite existing keys there.
# Never commit real credentials (the repo-root .env is gitignored; this file is not).

# OpenRouter free tier only (see the repo-root .env.example for the full tier layout and the
# 50-requests-per-day cap). Anthropic/OpenAI or any OpenAI-compatible server remain supported:
# LLM_MODEL=anthropic/... or openai/..., with the matching key below instead of OPENROUTER_API_KEY.
LLM_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free
LLM_FAST_MODEL=openrouter/google/gemma-4-26b-a4b-it:free
LLM_FALLBACK_MODELS=openrouter/openrouter/free
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=1200

EXA_API_KEY=
EXA_TIMEOUT_SECONDS=15

AMBIGUOUS_API_KEY=
AMBIGUOUS_TIMEOUT_SECONDS=15

# Required for `python -m agent serve` unless --local-no-auth (loopback dev only).
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

AGENT_PORT=8000
APPROVAL_SERVER_PORT=5050
APPROVAL_TIMEOUT_SECONDS=120
