# Copy desired settings into the repo-root .env. Never commit real credentials.
LLM_MODEL=anthropic/claude-sonnet-4-6
ANTHROPIC_API_KEY=
# For an openai/... LLM_MODEL instead:
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=1200
EXA_API_KEY=
EXA_TIMEOUT_SECONDS=15
AMBIGUOUS_API_KEY=
AMBIGUOUS_TIMEOUT_SECONDS=15
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AGENT_PORT=8000
APPROVAL_SERVER_PORT=5050
APPROVAL_TIMEOUT_SECONDS=120
