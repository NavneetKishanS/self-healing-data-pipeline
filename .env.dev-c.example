# Load these into .env locally; do not commit real credentials.
APPROVAL_SERVER_PORT=5050
APPROVAL_TIMEOUT_SECONDS=120
DEV_C_DATA_DIR=./runtime
APPROVAL_AUTH_MODE=local

# Optional Auth0 mode requires corresponding frontend settings and API permissions.
# APPROVAL_AUTH_MODE=auth0
# AUTH0_DOMAIN=your-tenant.eu.auth0.com
# AUTH0_AUDIENCE=https://pipeline-demo-api
# VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
# VITE_AUTH0_CLIENT_ID=your-spa-client-id
# VITE_AUTH0_AUDIENCE=https://pipeline-demo-api

# Ambiguous export remains disabled unless a key is configured.
# AMBIGUOUS_API_KEY=
# AMBIGUOUS_API_URL=https://app.ambiguous.ai/api/documents
