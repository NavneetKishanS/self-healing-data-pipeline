# Copy to .env at the repo root. Never commit real credentials.

# Model routing. Free OpenRouter models only: LLM_MODEL answers novel incidents and every critique;
# LLM_FAST_MODEL (optional) answers a diagnose call that already has a validated fast path in the
# procedural graph; LLM_FALLBACK_MODELS are tried in order when a request never produces an answer
# (rate limit, outage, empty reply). Free model IDs rotate: check https://openrouter.ai/models?q=free
# and verify with `python -m agent check --model`.
OPENROUTER_API_KEY=your_key_here
LLM_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free
LLM_FAST_MODEL=openrouter/google/gemma-4-26b-a4b-it:free
LLM_FALLBACK_MODELS=openrouter/openrouter/free
# ANTHROPIC_API_KEY=your_key_here          # only if LLM_MODEL points at anthropic/...

# Always-on mode (`python -m agent serve --watch`). Free OpenRouter models allow 50 requests per day
# for accounts that have bought less than $10 of credit; keep the budget under that.
AGENT_WATCH_INTERVAL_SECONDS=30
AGENT_DAILY_MODEL_CALL_BUDGET=40

APPROVAL_SERVER_PORT=5050
APPROVAL_TIMEOUT_SECONDS=120
